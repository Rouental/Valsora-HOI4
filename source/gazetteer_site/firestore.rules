rules_version = '2';
// The Valsora Gazetteer's atlas on the web site (docs/GAZETTEER.md). Paste it into the
// Firebase console (Firestore Database › Rules) with the author's Google address in place
// of OWNER_EMAIL, and publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // the author, signed in with Google
    function isAuthor() {
      return signedIn() && request.auth.token.email == "OWNER_EMAIL";
    }
    // the author or one of their admins (added on the page: admins/<their Google address>)
    function isAdmin() {
      return isAuthor()
        || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }
    // who the admins are: the author changes the list, the admins read it
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isAuthor();
    }
    // the passwords
    match /owner/{doc} {
      allow read, write: if isAdmin();
    }
    // nations not on the map yet, and whose map tools are open: everyone reads, admins change
    match /planned/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // a nation's documents sit in a folder named after its password, n/<TAG>/<key>/<document>.
    // Nothing lists n or n/<TAG>, so only the password finds them, and a folder takes writes
    // only once an admin has made its key document.
    match /n/{tag}/{key}/{doc} {
      function unlocked() {
        return exists(/databases/$(database)/documents/n/$(tag)/$(key)/key);
      }
      function known() {
        return doc in ["states", "provinces", "cities", "rivers", "rails", "politics", "flags",
                       "people", "about", "suggest", "releasables", "meta"]
          || doc.matches("req-[a-z0-9]{6,40}")
          || (doc.matches("img-[a-z0-9]{6,40}") && request.resource.data.data is string
              && request.resource.data.data.size() < 800000);
      }
      allow get, list: if true;
      allow create, update: if isAdmin() || (doc != "key" && unlocked() && known());
      allow delete: if isAdmin() || (doc != "key" && unlocked());
    }
  }
}
