# Valsora Deco UI - bitmap fonts (top bar and screens).
# Generated from Josefin Sans and Federo (SIL Open Font License); see README.
# The *_label, *_date and *_name fonts draw lowercase letters as capitals.
# The map font is not defined here: it replaces the files behind vanilla "tahoma_60"
# (gfx/fonts/hoi_mapfont4.fnt/.dds) without touching its definition.

bitmapfonts = {

	# readout values (U+25C6 is a diamond, for the factory counts)
	bitmapfont = {
		name = "valsora_deco_value_17"
		path = "gfx/fonts/valsora_deco_value_17"
		color = 0xfff4ecd9
